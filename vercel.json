{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, PATCH, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-Lead-Token, Authorization" }
      ]
    },
    {
      "source": "/api/lead",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [{ "source": "/badge-192.png", "destination": "/api/badge-png" }],
  "functions": {
    "api/badge-png.js": {
      "includeFiles": "api/badge-192.js"
    }
  }
}
